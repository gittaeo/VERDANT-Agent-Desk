# Copy to .env.local (ignored by Git). Never commit real credentials.
# Existing domestic-equity data adapters
DART_API_KEY=
KRX_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

# Both engines can be configured at once, then selected in the UI.
VERDANT_OLLAMA_URL=http://127.0.0.1:11434
VERDANT_OLLAMA_MODEL=
VERDANT_API_BASE_URL=
VERDANT_API_MODEL=
VERDANT_API_KEY=

# Optional self-hosted Worldmonitor. Empty means not connected.
VERDANT_WORLDMONITOR_URL=
VERDANT_PORT=5177
